{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfos.local/contracts/pfos-dnos-handoff/v1.1.0/schema.json",
  "title": "PFOS-v2 to DNOS v1.1.0 de-identified handoff package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "schema_version", "data_as_of", "exported_at", "source_app", "source_app_version", "source_rule_version", "currency", "timezone", "subject_ref", "consent", "decision_preferences", "hardship", "cashflow", "assets", "debts", "evidence_index", "risk_codes", "missing_fields", "pii_exclusion_confirmed", "payload_hash_sha256"],
  "properties": {
    "package_id": {"$ref": "#/$defs/uuid"},
    "schema_version": {"const": "1.1.0"},
    "data_as_of": {"$ref": "#/$defs/date"},
    "exported_at": {"$ref": "#/$defs/dateTime"},
    "source_app": {"const": "PFOS-v2"},
    "source_app_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "source_rule_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "currency": {"const": "CNY"},
    "timezone": {"const": "Asia/Shanghai"},
    "subject_ref": {"$ref": "#/$defs/ref"},
    "consent": {"$ref": "#/$defs/consent"},
    "decision_preferences": {"$ref": "#/$defs/preferences"},
    "hardship": {"$ref": "#/$defs/hardship"},
    "cashflow": {"$ref": "#/$defs/cashflow"},
    "assets": {"$ref": "#/$defs/assets"},
    "debts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/debt"}},
    "evidence_index": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/evidence"}},
    "risk_codes": {"type": "array", "maxItems": 80, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "missing_fields": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/missing"}},
    "pii_exclusion_confirmed": {"const": true},
    "payload_hash_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$"},
    "date": {"type": "string", "format": "date"},
    "dateTime": {"type": "string", "format": "date-time"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "money": {"type": "integer", "minimum": 0, "maximum": 10000000000},
    "nullableMoney": {"anyOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
    "consent": {
      "type": "object", "additionalProperties": false,
      "required": ["consent_record_ref", "purpose", "document_version", "confirmed_at"],
      "properties": {
        "consent_record_ref": {"$ref": "#/$defs/ref"},
        "purpose": {"const": "internal_debt_negotiation_decision_support"},
        "document_version": {"type": "string", "minLength": 1, "maxLength": 40},
        "confirmed_at": {"$ref": "#/$defs/dateTime"}
      }
    },
    "preferences": {
      "type": "object", "additionalProperties": false,
      "required": ["preference_status", "repayment_intent_status", "primary_objective", "secondary_objectives", "commitment_style", "max_monthly_commitment_fen", "max_upfront_payment_fen"],
      "properties": {
        "preference_status": {"enum": ["user_confirmed", "system_inferred_pending_confirmation", "not_collected"]},
        "repayment_intent_status": {"enum": ["confirmed", "conditional", "not_confirmed", "not_collected"]},
        "primary_objective": {"enum": ["stabilize_cashflow", "protect_credit", "reduce_total_cost", "protect_collateral", "legal_risk_control", "relationship_priority", null]},
        "secondary_objectives": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"enum": ["stabilize_cashflow", "protect_credit", "reduce_total_cost", "protect_collateral", "legal_risk_control", "relationship_priority"]}},
        "commitment_style": {"enum": ["conservative", "balanced", "maximum_feasible", "not_collected"]},
        "max_monthly_commitment_fen": {"$ref": "#/$defs/nullableMoney"},
        "max_upfront_payment_fen": {"$ref": "#/$defs/nullableMoney"}
      }
    },
    "hardship": {
      "type": "object", "additionalProperties": false,
      "required": ["reason_codes", "started_on", "expected_recovery_on", "evidence_status"],
      "properties": {
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["job_loss", "income_reduction", "illness", "family_burden", "business_failure", "disaster", "other", "none"]}},
        "started_on": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "expected_recovery_on": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "evidence_status": {"enum": ["document_verified", "self_reported", "not_available", "not_applicable"]}
      }
    },
    "cashflow": {
      "type": "object", "additionalProperties": false,
      "required": ["floor_monthly_income_fen", "expected_variable_monthly_income_fen", "upside_monthly_income_fen", "necessary_monthly_expense_fen", "available_cash_fen", "protected_cash_fen", "income_status", "income_change_effective_date", "income_evidence_status", "expense_evidence_status"],
      "properties": {
        "floor_monthly_income_fen": {"$ref": "#/$defs/money"},
        "expected_variable_monthly_income_fen": {"$ref": "#/$defs/money"},
        "upside_monthly_income_fen": {"$ref": "#/$defs/money"},
        "necessary_monthly_expense_fen": {"$ref": "#/$defs/money"},
        "available_cash_fen": {"$ref": "#/$defs/money"},
        "protected_cash_fen": {"$ref": "#/$defs/money"},
        "income_status": {"enum": ["active", "reduced", "interrupted", "unknown"]},
        "income_change_effective_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "income_evidence_status": {"enum": ["document_verified", "self_reported", "estimated", "unknown"]},
        "expense_evidence_status": {"enum": ["document_verified", "self_reported", "estimated", "unknown"]},
        "necessary_expense_breakdown": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["category", "amount_fen"], "properties": {"category": {"enum": ["housing", "food_and_utilities", "healthcare", "dependents", "work_and_transport", "tax_and_social_security", "other_essential"]}, "amount_fen": {"$ref": "#/$defs/money"}}}}
      }
    },
    "assets": {
      "type": "object", "additionalProperties": false,
      "required": ["liquid_assets_fen", "essential_assets_fen", "pledged_assets_fen", "voluntary_disposable_assets_fen", "asset_data_status"],
      "properties": {"liquid_assets_fen": {"$ref": "#/$defs/money"}, "essential_assets_fen": {"$ref": "#/$defs/money"}, "pledged_assets_fen": {"$ref": "#/$defs/money"}, "voluntary_disposable_assets_fen": {"$ref": "#/$defs/money"}, "asset_data_status": {"enum": ["verified", "self_reported", "estimated", "unknown"]}}
    },
    "entityRole": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_ref", "role", "entity_kind", "organization_name", "brand_name", "verification_status", "evidence_refs"],
      "properties": {
        "entity_ref": {"$ref": "#/$defs/ref"},
        "role": {"enum": ["platform_entry", "legal_lender", "credit_reporter", "guarantor_or_insurer", "post_loan_manager", "collection_executor", "assignee", "payment_recipient"]},
        "entity_kind": {"enum": ["organization", "private_individual", "unknown"]},
        "organization_name": {"type": ["string", "null"], "maxLength": 120},
        "brand_name": {"type": ["string", "null"], "maxLength": 120},
        "verification_status": {"enum": ["confirmed", "contract_check_required", "institution_confirmation_required", "unknown"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      },
      "allOf": [{"if": {"properties": {"entity_kind": {"const": "private_individual"}}}, "then": {"properties": {"organization_name": {"const": null}, "brand_name": {"const": null}}}}]
    },
    "debt": {
      "type": "object", "additionalProperties": false,
      "required": ["debt_ref", "debt_type", "data_confidence", "entity_roles", "product", "contract", "amounts", "schedule", "account_state", "security", "evidence_refs"],
      "properties": {
        "debt_ref": {"$ref": "#/$defs/ref"},
        "debt_type": {"enum": ["credit_card", "bank_consumer_loan", "consumer_finance", "auto_finance", "microloan", "trust_loan", "secured_mortgage", "installment_purchase", "private_loan", "other_personal_debt", "unknown"]},
        "data_confidence": {"enum": ["document_verified", "institution_confirmed", "self_reported", "estimated", "unknown"]},
        "entity_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entityRole"}, "contains": {"type": "object", "properties": {"role": {"const": "legal_lender"}}}, "minContains": 1, "maxContains": 1},
        "product": {"type": "object", "additionalProperties": false, "required": ["brand_name", "product_name", "product_code", "product_identification_status"], "properties": {"brand_name": {"type": ["string", "null"], "maxLength": 120}, "product_name": {"type": ["string", "null"], "maxLength": 120}, "product_code": {"type": ["string", "null"], "maxLength": 120, "pattern": "^[A-Za-z0-9_.:/-]*$"}, "product_identification_status": {"enum": ["confirmed", "brand_only", "self_reported", "unknown"]}}},
        "contract": {"type": "object", "additionalProperties": false, "required": ["contract_ref", "contract_version_ref", "started_on", "matures_on", "repayment_method", "term_remaining_months", "contract_status"], "properties": {"contract_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "contract_version_ref": {"type": ["string", "null"], "maxLength": 120, "pattern": "^[A-Za-z0-9_.:/-]*$"}, "started_on": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "matures_on": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "repayment_method": {"enum": ["equal_installment", "equal_principal", "minimum_payment", "interest_first", "balloon", "revolving", "flexible", "unknown"]}, "term_remaining_months": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 600}, {"type": "null"}]}, "contract_status": {"enum": ["present_complete", "present_incomplete", "missing"]}}},
        "amounts": {"type": "object", "additionalProperties": false, "required": ["principal_outstanding_fen", "regular_interest_outstanding_fen", "penalty_interest_outstanding_fen", "fees_outstanding_fen", "total_claimed_balance_fen", "current_amount_due_fen", "scheduled_monthly_due_fen", "annual_contract_rate_bps", "annualized_total_cost_bps", "penalty_rate_bps", "rate_basis", "amount_breakdown_status", "amount_as_of"], "properties": {"principal_outstanding_fen": {"$ref": "#/$defs/money"}, "regular_interest_outstanding_fen": {"$ref": "#/$defs/nullableMoney"}, "penalty_interest_outstanding_fen": {"$ref": "#/$defs/nullableMoney"}, "fees_outstanding_fen": {"$ref": "#/$defs/nullableMoney"}, "total_claimed_balance_fen": {"$ref": "#/$defs/money"}, "current_amount_due_fen": {"$ref": "#/$defs/money"}, "scheduled_monthly_due_fen": {"$ref": "#/$defs/money"}, "annual_contract_rate_bps": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 100000}, {"type": "null"}]}, "annualized_total_cost_bps": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 100000}, {"type": "null"}]}, "penalty_rate_bps": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 100000}, {"type": "null"}]}, "rate_basis": {"enum": ["contract_nominal", "disclosed_apr", "calculated", "unknown"]}, "amount_breakdown_status": {"enum": ["complete", "partial", "unknown"]}, "amount_as_of": {"$ref": "#/$defs/date"}}},
        "schedule": {"type": "object", "additionalProperties": false, "required": ["next_due_date", "due_day", "scheduled_end_date", "payment_schedule_status"], "properties": {"next_due_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "due_day": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 31}, {"type": "null"}]}, "scheduled_end_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "payment_schedule_status": {"enum": ["complete", "partial", "unknown"]}}},
        "account_state": {"type": "object", "additionalProperties": false, "required": ["delinquency_state", "delinquency_days", "collection_stage", "legal_stage", "next_legal_deadline", "credit_reporting_state"], "properties": {"delinquency_state": {"enum": ["current", "anticipated_shortfall", "days_1_30", "days_31_90", "days_91_plus", "charged_off_or_transferred", "unknown"]}, "delinquency_days": {"type": "integer", "minimum": 0, "maximum": 36500}, "collection_stage": {"enum": ["none", "reminder", "internal_collection", "external_collection", "demand_letter", "unknown"]}, "legal_stage": {"enum": ["none", "pre_litigation_mediation", "litigation", "arbitration", "judgment_or_award", "enforcement", "unknown"]}, "next_legal_deadline": {"anyOf": [{"$ref": "#/$defs/dateTime"}, {"type": "null"}]}, "credit_reporting_state": {"enum": ["current", "overdue_reported", "restructured_reported", "disputed", "not_reported", "unknown"]}}},
        "security": {"type": "object", "additionalProperties": false, "required": ["secured", "collateral_ref", "collateral_type", "collateral_essential_use", "collateral_realizable_value_fen", "guaranteed", "guarantee_kind"], "properties": {"secured": {"type": "boolean"}, "collateral_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "collateral_type": {"enum": ["primary_residence", "other_real_estate", "vehicle", "deposit", "other", "unknown", null]}, "collateral_essential_use": {"type": ["boolean", "null"]}, "collateral_realizable_value_fen": {"$ref": "#/$defs/nullableMoney"}, "guaranteed": {"type": "boolean"}, "guarantee_kind": {"enum": ["natural_person", "company", "insurer", "financing_guarantee", "co_borrower", "unknown", null]}}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_ref", "evidence_type", "related_debt_refs", "content_hash_sha256", "document_date", "verification_status", "source_tier"], "properties": {"evidence_ref": {"$ref": "#/$defs/ref"}, "evidence_type": {"enum": ["contract", "statement", "credit_report", "institution_notice", "collection_notice", "legal_document", "income_proof", "expense_proof", "hardship_proof", "collateral_proof", "other"]}, "related_debt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "content_hash_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "document_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "verification_status": {"enum": ["indexed_only", "pfos_extracted", "pfos_human_verified", "expired", "unknown"]}, "source_tier": {"enum": ["contract_or_official_document", "institution_statement", "user_statement", "unknown"]}}
    },
    "missing": {"type": "object", "additionalProperties": false, "required": ["path", "reason_code", "severity", "blocks", "acquisition_code"], "properties": {"path": {"type": "string", "pattern": "^/"}, "reason_code": {"enum": ["not_collected", "user_unknown", "document_missing", "conflicting_sources", "not_applicable"]}, "severity": {"enum": ["blocking", "important", "informational"]}, "blocks": {"type": "array", "uniqueItems": true, "items": {"enum": ["baseline", "policy_match", "offer_acceptance", "client_ready_report"]}}, "acquisition_code": {"enum": ["RETURN_TO_PFOS", "INDEX_CONTRACT", "INDEX_STATEMENT", "INDEX_CREDIT_REPORT", "VERIFY_INSTITUTION", "VERIFY_LEGAL_STAGE", "VERIFY_OFFICIAL_CHANNEL", "NO_ACTION_REQUIRED"]}}}
  }
}
